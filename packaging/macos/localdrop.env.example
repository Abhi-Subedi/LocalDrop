# LocalDrop configuration for the launchd daemon.
#
# This file is the template install.sh reads. On macOS, launchd does not
# support systemd's EnvironmentFile, so install.sh copies the values here into
# the EnvironmentVariables dictionary of
# /Library/LaunchDaemons/io.github.abhisubedi.localdrop.plist.
#
# After editing the plist:  sudo launchctl kickstart -k system/io.github.abhisubedi.localdrop
# Reference: docs/CONFIGURATION.md

# --- generated at install time; keep this line ---
LOCALDROP_SECRET_KEY=CHANGE_ME

# --- network ---
LOCALDROP_PORT=8080
LOCALDROP_HOST=0.0.0.0

# The address other devices on your LAN use, so share links and the QR code
# point somewhere real. install.sh fills this in from the detected IP.
# LOCALDROP_PUBLIC_URL=http://192.168.1.20:8080

# --- database ------------------------------------------------------------
# Uncomment ONLY if you run your own PostgreSQL. When unset, LocalDrop manages
# an embedded cluster inside the data directory — nothing extra to install.
# LOCALDROP_DATABASE_URL=postgresql+psycopg://localdrop:secret@127.0.0.1:5432/localdrop

# --- logging -------------------------------------------------------------
LOCALDROP_LOG_FORMAT=console
LOCALDROP_LOG_LEVEL=INFO
