# LocalDrop configuration for the systemd service.
#
# This file is an EnvironmentFile: KEY=VALUE lines only, no `export`, and no
# shell expansion. Anything not set here uses the built-in default.
#
# After editing:  sudo systemctl restart localdrop
# Reload the reference: docs/CONFIGURATION.md

# --- generated at install time; keep this line ---
LOCALDROP_SECRET_KEY=CHANGE_ME

# --- network ---
# Port the web UI and API listen on. If you serve LocalDrop behind a reverse
# proxy, keep this on 8080 and let the proxy own 443.
LOCALDROP_PORT=8080

# The address other devices on your LAN use. Set this so share links and the
# QR code point somewhere real. Leave empty to derive it per request.
# LOCALDROP_PUBLIC_URL=http://192.168.1.20:8080

# Bind address. 0.0.0.0 serves the whole LAN (the normal choice);
# 127.0.0.1 makes the server reachable only through a local reverse proxy.
LOCALDROP_HOST=0.0.0.0

# --- database ------------------------------------------------------------
# Uncomment ONLY if you run your own PostgreSQL. When unset, LocalDrop manages
# an embedded cluster inside the data directory, which needs no setup and no
# second service to remember to start.
# LOCALDROP_DATABASE_URL=postgresql+psycopg://localdrop:secret@127.0.0.1:5432/localdrop

# Port for the embedded cluster. Only change it if 5439 is already taken.
# LOCALDROP_PG_PORT=5439

# --- storage -------------------------------------------------------------
# Default: 100 GiB. 0 disables the limit (not recommended).
# LOCALDROP_MAX_UPLOAD_BYTES=107374182400

# --- reverse proxy -------------------------------------------------------
# Number of trusted proxy hops in front of the app (Caddy/nginx/Cloudflare).
# 0 means "no proxy" and the client IP is taken from the socket. Set this to
# the real hop count or rate limiting will attribute every user to one IP.
# LOCALDROP_TRUSTED_PROXIES=0

# --- logging -------------------------------------------------------------
# console = human-readable (default for a service), json = machine-readable.
LOCALDROP_LOG_FORMAT=console
LOCALDROP_LOG_LEVEL=INFO
