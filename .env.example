# LocalDrop configuration (copy to .env and adjust)
# All settings are LOCALDROP_* environment variables.

# REQUIRED in production: session/token HMAC secret, at least 32 characters.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
LOCALDROP_SECRET_KEY=

# PostgreSQL connection string.
LOCALDROP_DATABASE_URL=postgresql+psycopg://localdrop:CHANGE_ME@postgres:5432/localdrop

# Where uploaded files are stored (Docker volume mount point).
LOCALDROP_DATA_DIR=/var/lib/localdrop

# Public URL used when building share links (set when behind a proxy).
#LOCALDROP_PUBLIC_URL=https://files.example.com

# Server port (container listens here; publish with Docker).
LOCALDROP_PORT=8080

# Limits
LOCALDROP_MAX_UPLOAD_BYTES=107374182400
LOCALDROP_UPLOAD_SESSIONS_MAX=20
LOCALDROP_TRASH_RETENTION_DAYS=30

# Sessions (minutes): sliding idle expiry / absolute cap
LOCALDROP_SESSION_IDLE_MINUTES=10080
LOCALDROP_SESSION_ABSOLUTE_MINUTES=43200

# Logging: json | dev
LOCALDROP_LOG_FORMAT=json
LOCALDROP_LOG_LEVEL=INFO

# Number of trusted reverse-proxy hops (0 = clients connect directly).
LOCALDROP_TRUSTED_PROXIES=0

# NEVER set in production:
#LOCALDROP_DEV_MODE=true
