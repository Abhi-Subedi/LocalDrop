# LocalDrop configuration for Docker Compose.
#
#   cp .env.example .env    # then edit the two REQUIRED values
#   docker compose up -d
#
# Generate a secret key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# This file is for the Docker stack only. For a native install (install.sh,
# Homebrew, the Windows installer) configuration lives in localdrop.env beside
# the data directory — see docs/CONFIGURATION.md for the full reference.

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# Session and token HMAC secret. At least 32 characters. The server refuses to
# start without it, so a weak or short value is a boot failure rather than a
# silent vulnerability.
LOCALDROP_SECRET_KEY=CHANGE_ME_32_CHARS_MINIMUM

# Password for the bundled PostgreSQL. The database is only reachable inside the
# compose network, but this is still the password your files are guarded by.
POSTGRES_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------------------
# COMMON
# ---------------------------------------------------------------------------

# Host port published for the web UI. The container always listens on 8080.
LOCALDROP_HOST_PORT=8080

# Container image tag. `stable` tracks the newest release; pin an exact version
# (e.g. 1.1.0) for a reproducible deploy. The image is pulled from
# ghcr.io/abhi-subedi/localdrop — there is no build step.
LOCALDROP_IMAGE_TAG=stable

# Public URL used when building share links and QR codes.
# Leave empty on a plain LAN (links then use the request's Host header).
# Set it behind a reverse proxy so links point at the public address.
# Example: LOCALDROP_PUBLIC_URL=https://files.example.com
#LOCALDROP_PUBLIC_URL=

# Max single-file upload in bytes (default 100 GiB; 0 = unlimited, not advised).
LOCALDROP_MAX_UPLOAD_BYTES=107374182400

# ---------------------------------------------------------------------------
# ADVANCED — the defaults are fine for most home servers
# ---------------------------------------------------------------------------
# Every setting is documented in docs/CONFIGURATION.md, which CI keeps in sync
# with backend/src/localdrop/config.py.

# PostgreSQL connection string. compose wires this for you; only change it to
# point at an external database. (The native installs leave it unset and start
# their own embedded PostgreSQL instead.)
#LOCALDROP_DATABASE_URL=postgresql+psycopg://localdrop:${POSTGRES_PASSWORD}@postgres:5432/localdrop

# Where uploaded files live. This is the compose volume mount point; keep it
# stable, because database rows reference paths relative to it.
#LOCALDROP_DATA_DIR=/data

# Seconds to wait for a TCP connect to PostgreSQL. Keep this under your
# healthcheck timeout (Docker uses 5s) or a dead database looks like a hang.
#LOCALDROP_DB_CONNECT_TIMEOUT=5
#LOCALDROP_DB_KEEPALIVE_SECONDS=30

# Concurrent upload sessions per user; how long an unfinished upload survives.
#LOCALDROP_UPLOAD_SESSIONS_MAX=20
#LOCALDROP_UPLOAD_TTL_DAYS=7

# Trash retention (days) — deleted files are recoverable until then.
#LOCALDROP_TRASH_RETENTION_DAYS=30

# Sessions, in minutes: sliding idle expiry and the absolute cap.
#LOCALDROP_SESSION_IDLE_MINUTES=10080
#LOCALDROP_SESSION_ABSOLUTE_MINUTES=43200

# Logging. `json` for aggregation, `console` for a human reading `docker logs`.
#LOCALDROP_LOG_FORMAT=json
#LOCALDROP_LOG_LEVEL=INFO

# Number of trusted reverse-proxy hops in X-Forwarded-For. Keep it at 0 unless
# a proxy is genuinely the only path in: each trusted hop lets the previous one
# forge a client IP, which defeats per-IP rate limiting.
#LOCALDROP_TRUSTED_PROXIES=0

# Write a pg_dump into /data/backups before applying migrations, and refuse to
# start if that backup fails. The compose file sets this to 1; you can override.
#LOCALDROP_BACKUP_BEFORE_MIGRATE=1

# NEVER set this in production. It relaxes the secret-key requirement, enables
# /api/docs and enables CORS.
#LOCALDROP_DEV_MODE=false
