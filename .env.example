# LocalDrop configuration — copy to `.env` and adjust, then:
#   docker compose up -d --build
#
# Generate secrets with:
#   python -c "import secrets; print(secrets.token_hex(32))"

# REQUIRED: session/token HMAC secret, at least 32 characters.
LOCALDROP_SECRET_KEY=CHANGE_ME_32_CHARS_MINIMUM

# REQUIRED: PostgreSQL password (used by both the db and the app service).
POSTGRES_PASSWORD=CHANGE_ME

# Host port published for the web UI (container always listens on 8080).
LOCALDROP_HOST_PORT=8080

# Public URL used when building share links.
# Leave empty on a plain LAN (links use the request host); set it when
# behind a reverse proxy so links/QR codes point at the public address.
# Example: LOCALDROP_PUBLIC_URL=https://files.example.com
#LOCALDROP_PUBLIC_URL=

# Max single-file upload size in bytes (default 100 GiB; 0 = unlimited).
LOCALDROP_MAX_UPLOAD_BYTES=107374182400

# --- advanced (defaults are fine for most home servers) ---

# PostgreSQL connection string (compose default; change only for external DB).
#LOCALDROP_DATABASE_URL=postgresql+psycopg://localdrop:${POSTGRES_PASSWORD}@postgres:5432/localdrop

# Where uploaded files are stored (Docker volume mount point; keep stable —
# database rows reference this path, so don't change it after first boot).
#LOCALDROP_DATA_DIR=/data

# Upload sessions per user / trash retention (days).
#LOCALDROP_UPLOAD_SESSIONS_MAX=20
#LOCALDROP_TRASH_RETENTION_DAYS=30

# Sessions (minutes): sliding idle expiry / absolute cap.
#LOCALDROP_SESSION_IDLE_MINUTES=10080
#LOCALDROP_SESSION_ABSOLUTE_MINUTES=43200

# Logging: json | dev
#LOCALDROP_LOG_FORMAT=json
#LOCALDROP_LOG_LEVEL=INFO

# Trusted reverse-proxy hops for X-Forwarded-For (0 = clients connect directly).
#LOCALDROP_TRUSTED_PROXIES=0

# NEVER set in production:
#LOCALDROP_DEV_MODE=true
